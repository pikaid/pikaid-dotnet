<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The previous LTS runtime. A net8.0 application can only bind the
         netstandard2.1 asset, so this consumer proves the shipped down-level
         assembly actually runs on a down-level runtime. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Restored from the locally packed nupkg; no ProjectReference is involved. -->
    <PackageReference Include="Pikaid" Version="[$(PikaidVersion)]" />
  </ItemGroup>

</Project>
